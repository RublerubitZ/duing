# 두잉 백엔드 환경변수 예시.
# 로컬: 이 파일을 backend/.env 로 복사해 값을 채운다.
# 운영: deploy/.env 로 복사해 값을 채운다(docker-compose 가 env_file 로 주입).
# !! 실제 시크릿을 이 예시 파일에 적지 말 것 — .env / .env.* 는 .gitignore 로 무시된다.

# ── 데이터베이스 (필수) ──────────────────────────────────────────
# Supabase 세션 풀러(:5432) + sslmode=require.
# 트랜잭션 풀러(:6543)는 JDBC prepared statement 와 충돌하니 사용 금지.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
# HikariCP 고정 풀 크기 — 10 을 넘기지 말 것. Supabase 세션 풀러 한도 15 에서 백업(GitHub Actions 덤프)·관리도구 몫 5 를
# 남긴다. 15 로 올리면 04:15 백업이 커넥션을 못 잡아 실패한다(2026-09-20 실사고, 알림은 #1255).
DB_POOL_MAX_SIZE=10
# HikariCP 커넥션 수명(ms, 기본 600000=10분). 재접속 TLS/세션 초기화가 egress 를 만들어 단계 상향 중 —
# 600s 안정 확인 후 1200000 → 1800000 순서로 올리고, connection reset 이 늘면 직전 값으로 되돌린다.
DB_MAX_LIFETIME_MS=600000

# ── 인증 / 보안 (필수) ───────────────────────────────────────────
JWT_SECRET=
# 웹 Access JWT/Cookie/auth_hint의 고정 1시간 계약. 다른 값이면 기동 실패(fail-fast).
JWT_EXPIRY_MS=3600000
AUTH_HINT_SECRET=
# 로컬은 비워 두어 auth_hint와 Access Token Cookie를 모두 localhost host-only로 발급한다.
# 운영 deploy/.env에서는 반드시 정확히 .duings.com으로 설정한다(누락/다른 값은 기동 실패).
AUTH_HINT_COOKIE_DOMAIN=
# MO 인증 코드 파생 HMAC 키 (필수) — 임의의 긴 랜덤 문자열
PHONE_VERIFICATION_SECRET=
# 회비 계좌번호 AES-256-GCM 암호화 키. base64(32바이트) — 생성: openssl rand -base64 32
# 미설정/길이 불일치 시 부팅 실패(fail-fast). dev·prod 키를 분리하고 절대 커밋하지 말 것.
FEE_ACCOUNT_ENC_KEY=
# 콤마 구분 CORS 허용 오리진. 운영 예: https://duings.com,https://www.duings.com
# 빈 값 또는 '*' 이면 부팅이 실패한다(fail-fast).
CORS_ALLOWED_ORIGINS=https://duings.com,https://www.duings.com

# ── 파일 스토리지 / Cloudflare R2 (운영 필수) ────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=duing
# S3_REGION 은 운영(application-prod.yml)에서 auto 로 고정되므로 이 값은 로컬 전용이다.
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ── BANK API / 회비 자동매칭 (선택) ──────────────────────────────
# BANK API(bankapi.co.kr) 인증 키. 코드·yml 하드코딩 금지 — 환경변수로만 주입한다.
# 미설정 시 거래내역 동기화가 실패한다(제공사 401 → 우리 응답 502). 자동매칭 허용 동아리 관리 화면은 DB 기반이라 정상 동작.
BANK_API_KEY=
BANK_API_SECRET=
# Octomo MO 조회 (운영 필수 — prod 는 mo.provider 기본이 octomo 라 미주입 시 부팅이 실패한다. 로컬 stub 은 불필요)
OCTOMO_API_KEY=

# ── 모니터링 / Sentry ────────────────────────────────────────────
# 운영(application-prod.yml)은 SENTRY_DSN 을 폴백 없이 요구한다(누락 시 부팅 실패).
# 의도적으로 끄려면 빈 값으로 둔다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Slack 운영 알림 Incoming Webhook URL (운영 권장 — 미설정/빈 값이면 비활성으로 부팅하며 시작 로그에 WARN 한 줄).
# 로컬은 비워 둔다(운영 webhook 을 로컬에서 쓰지 말 것). 채널·이벤트 목록은 deploy/MONITORING.md.
SLACK_WEBHOOK_URL=

# ── 기타 (선택) ──────────────────────────────────────────────────
# 공지 커버 이미지의 절대 URL prefix. 비우면 상대경로(/files/...) — 운영 이미지 호스트가 다르면 설정.
NOTICE_COVER_IMAGE_URL_PREFIX=
# PII 보관/파기 잡 — 운영 기본 활성(45일 보관 후 파기). 끄려면 false.
DUING_PII_RETENTION_ENABLED=true
# 모집 마감 후 지원서 자유서술 답변·미제출 초안 보관기간 — 개인정보 처리방침 3조 "모집 종료 후 6개월" 과 일치.
# 위 PII 파기 잡이 함께 처리한다. 보통 건드리지 않는다.
DUING_PII_APPLICATION_ANSWER_WINDOW=P6M
# 업로드 고아 객체 정리 잡(매시 :20 Asia/Seoul) — 운영 기본 활성(스케줄링). 끄려면 false.
DUING_UPLOAD_PURGE_ENABLED=true
# 실삭제 스위치 — 1차 릴리스는 dry-run(후보를 로그로만 기록). 로그에 WARN 0건인 상태가 일주일 유지되면 true 로 전환한다.
DUING_UPLOAD_PURGE_DELETE_ENABLED=false
# 업로드 후 이 기간(PT24H)을 넘겨도 어떤 엔티티에도 연결되지 않은 객체를 정리 대상으로 삼는다.
DUING_UPLOAD_PURGE_WINDOW=PT24H
# 회비 연체 전이 크론(매일 00:10 Asia/Seoul) — 마감 지난 PENDING·PARTIAL_PAID 청구를 OVERDUE 로 전이하고 연체 알림 발송.
# 운영 활성(true) 권장. 미설정 시 기본 false(잡 미등록).
DUING_FEE_OVERDUE_ENABLED=true
# 회비 자동 월발행 크론(매일 00:20 Asia/Seoul) — MONTHLY auto_issue 정책의 그 달 청구를 자동 발행.
# 기본 비활성(false). 운영에서만 true 권장.
DUING_FEE_AUTO_ISSUE_ENABLED=false

# ── 컨테이너 배포 전용 (deploy/.env 에서만 사용) ──────────────────
# docker-compose 가 가져올 백엔드 이미지. 롤백 가능하도록 운영은 :latest 대신 구체 태그/SHA 를 쓴다.
# (compose 가 BACKEND_IMAGE 를 필수로 요구 — 미설정 시 기동 실패)
# Private GHCR 패키지 — 수동 pull 전 classic PAT(read:packages)로 docker login 필요(deploy/README.md).
BACKEND_IMAGE=ghcr.io/rublerubitz/duing-backend:<tag>
