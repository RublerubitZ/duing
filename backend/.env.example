# Du-ing 백엔드 환경변수 템플릿
# 1) 이 파일을 `.env` 로 복사 후 실제 값 채우기 (`.env` 는 커밋 금지)
# 2) IntelliJ 의 Run Configuration → Environment variables 에 등록하거나
#    `export $(cat .env | xargs) && ./gradlew bootRun` 로 실행

# Supabase PostgreSQL (Session Pooler 사용 — Transaction Pooler 6543 은 Flyway/Hibernate 와 호환 X)
# Dashboard → Project Settings → Database → Connection string → JDBC → Session pooler 에서 복사
DB_URL=jdbc:postgresql://aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=REPLACE_ME

# JWT
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
JWT_EXPIRY_MS=3600000

# 로컬 파일 저장 경로 (없으면 자동 생성)
FILE_UPLOAD_DIR=/tmp/duing/uploads
# LocalFileStorageService 가 반환하는 storageKey 의 절대 URL prefix.
# 비워두면 상대 경로(`/files/...`) 로 폴백 — Next.js dev 와 동일 origin 이 아니므로 채워두는 걸 권장.
FILE_LOCAL_BASE_URL=http://localhost:8080

# 파일 저장소 선택. local 또는 s3
FILE_STORAGE_PROVIDER=local

# FILE_STORAGE_PROVIDER=s3 일 때 (로컬 MinIO 또는 디버깅용)
# - prod (application-prod.yml) 는 별도로 R2_* 변수를 사용 — 아래 prod 섹션 참고
# - public-base-url 은 prod 에서 https://files.duing.app 로 고정 (시크릿 아님)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=duing
S3_PUBLIC_BASE_URL=

# prod (Cloudflare R2) — CI Secret 으로만 주입. 로컬 .env 에는 절대 적지 말 것.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=duing
