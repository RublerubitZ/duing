# 두잉 백엔드 환경변수 예시.
# 로컬: 이 파일을 backend/.env 로 복사해 값을 채운다.
# 운영: deploy/.env 로 복사해 값을 채운다(docker-compose 가 env_file 로 주입).
# !! 실제 시크릿을 이 예시 파일에 적지 말 것 — .env / .env.* 는 .gitignore 로 무시된다.

# ── 데이터베이스 (필수) ──────────────────────────────────────────
# Supabase 세션 풀러(:5432) + sslmode=require.
# 트랜잭션 풀러(:6543)는 JDBC prepared statement 와 충돌하니 사용 금지.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
# HikariCP 고정 풀 크기. Supabase 플랜의 풀러 연결 한도 안에서 조정한다(기본 10).
DB_POOL_MAX_SIZE=10

# ── 인증 / 보안 (필수) ───────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY_MS=3600000
EMAIL_VERIFICATION_SECRET=
# MO 인증 코드 파생 HMAC 키 (필수) — 임의의 긴 랜덤 문자열
PHONE_VERIFICATION_SECRET=
# 회비 계좌번호 AES-256-GCM 암호화 키. base64(32바이트) — 생성: openssl rand -base64 32
# 미설정/길이 불일치 시 부팅 실패(fail-fast). dev·prod 키를 분리하고 절대 커밋하지 말 것.
FEE_ACCOUNT_ENC_KEY=
# 콤마 구분 CORS 허용 오리진. 운영 예: https://duings.com,https://www.duings.com
# 빈 값 또는 '*' 이면 부팅이 실패한다(fail-fast).
CORS_ALLOWED_ORIGINS=https://duings.com,https://www.duings.com

# ── 파일 스토리지 / Cloudflare R2 (운영 필수) ────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=duing
# S3_REGION 은 운영(application-prod.yml)에서 auto 로 고정되므로 이 값은 로컬 전용이다.
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ── 이메일 / Resend (운영 필수) ──────────────────────────────────
# ⚠️ RESEND_FROM/BREVO_FROM 에 한글을 넣는 것은 운영(deploy/.env → docker env_file → 환경변수)만 안전하다.
#    로컬 backend/.env 는 spring.config.import 가 properties(ISO-8859-1) 로 읽어 한글이 깨진다
#    (발신자명 "두잉" → "ë‘ì..." mojibake). 로컬에서는 두 변수를 설정하지 말 것 —
#    미설정 시 yml 기본값(UTF-8, "두잉 <noreply@duings.com>")이 적용되어 정상 표기된다.
RESEND_API_KEY=
RESEND_FROM=두잉 <noreply@duings.com>

# ── 이메일 폴백 / Brevo SMTP (선택 — 권장) ───────────────────────
# Resend 가 429(무료 플랜 일일 한도)·5xx·타임아웃으로 실패할 때만 사용하는 폴백 발송 경로.
# Brevo 대시보드 SMTP & API 페이지의 로그인 계정과 SMTP 키를 넣는다(smtp-relay.brevo.com:587).
# 미설정이어도 부팅·Resend 발송은 정상이며, 폴백 시도만 인증 실패로 무력화된다.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# 폴백 발신자 표기 — RESEND_FROM 을 커스텀했다면 같은 값으로 맞춘다(기본값은 서로 동일).
# 발신 주소 도메인은 Brevo 에서도 발신자 인증(SPF/DKIM)이 되어 있어야 한다.
# ⚠️ 한글 값은 운영 전용 — 로컬 .env 에 넣으면 깨진다(위 Resend 섹션 경고 참조).
BREVO_FROM=두잉 <noreply@duings.com>

# ── BANK API / 회비 자동매칭 (선택) ──────────────────────────────
# BANK API(bankapi.co.kr) 인증 키. 코드·yml 하드코딩 금지 — 환경변수로만 주입한다.
# 미설정 시 회비 자동매칭(거래 조회/계좌 등록) 기능만 비동작하고 그 외 기동에는 영향이 없다.
BANK_API_KEY=
BANK_API_SECRET=
# Octomo MO 조회 (선택 — mo.provider=octomo 일 때만 필요)
OCTOMO_API_KEY=

# ── 모니터링 / Sentry ────────────────────────────────────────────
# 운영(application-prod.yml)은 SENTRY_DSN 을 폴백 없이 요구한다(누락 시 부팅 실패).
# 의도적으로 끄려면 빈 값으로 둔다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── 기타 (선택) ──────────────────────────────────────────────────
# 공지 커버 이미지의 절대 URL prefix. 비우면 상대경로(/files/...) — 운영 이미지 호스트가 다르면 설정.
NOTICE_COVER_IMAGE_URL_PREFIX=
# PII 보관/파기 잡 — 운영 기본 활성(45일 보관 후 파기). 끄려면 false.
DUING_PII_RETENTION_ENABLED=true
# 회비 연체 전이 크론(매일 00:10 Asia/Seoul) — 마감 지난 PENDING·PARTIAL_PAID 청구를 OVERDUE 로 전이하고 연체 알림 발송.
# 운영 활성(true) 권장. 미설정 시 기본 false(잡 미등록).
DUING_FEE_OVERDUE_ENABLED=true
# 회비 자동 월발행 크론(매일 00:20 Asia/Seoul) — MONTHLY auto_issue 정책의 그 달 청구를 자동 발행.
# 기본 비활성(false). 운영에서만 true 권장.
DUING_FEE_AUTO_ISSUE_ENABLED=false

# ── 컨테이너 배포 전용 (deploy/.env 에서만 사용) ──────────────────
# docker-compose 가 가져올 백엔드 이미지. 롤백 가능하도록 운영은 :latest 대신 구체 태그/SHA 를 쓴다.
# (compose 가 BACKEND_IMAGE 를 필수로 요구 — 미설정 시 기동 실패)
# Private GHCR 패키지 — 수동 pull 전 classic PAT(read:packages)로 docker login 필요(deploy/README.md).
BACKEND_IMAGE=ghcr.io/rublerubitz/duing-backend:<tag>
