# 백엔드 API 베이스 URL (로컬 부팅 기본값)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Middleware가 라우팅 UX용 auth_hint 서명을 검증하는 서버 전용 키 (NEXT_PUBLIC_ 접두사 금지)
AUTH_HINT_SECRET=

# 사이트 절대 URL — sitemap.xml / robots.txt 의 절대 경로 생성에 사용. 미설정 시 https://duings.com 폴백.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry 는 로컬에서 기본 비활성. 로컬 캡처 테스트가 필요할 때만 DSN 을 채운다.
# NEXT_PUBLIC_SENTRY_DSN=
