# 운영 빌드용 환경변수 예시 — Vercel 프로젝트 환경변수(Production)에 동일하게 설정한다.
# NEXT_PUBLIC_* 는 빌드 타임에 번들로 인라인되므로, 누락 시 운영 앱이 localhost 를 호출해 전체 비동작.
NEXT_PUBLIC_API_BASE_URL=https://api.duings.com/api/v1

# Middleware가 라우팅 UX용 auth_hint 서명을 검증하는 서버 전용 키 (백엔드와 동일한 별도 키, NEXT_PUBLIC_ 접두사 금지)
AUTH_HINT_SECRET=

# 사이트 절대 URL — sitemap.xml / robots.txt 의 절대 경로 생성에 사용. 미설정 시 https://duings.com 폴백.
NEXT_PUBLIC_SITE_URL=https://duings.com

# Sentry — 클라이언트·서버 공용 공개 DSN. 비우면 Sentry 비활성(이벤트 미전송).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
