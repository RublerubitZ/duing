{
  "name": "duing-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @duing/web dev",
    "build": "pnpm -r --filter=!@duing/web build && pnpm --filter @duing/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test --run",
    "gen:api": "openapi-typescript http://localhost:8080/v3/api-docs -o packages/api/src/generated/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
